# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env.

# --- App ---
APP_NAME=TeamBuilding Portal
APP_ENV=development
API_PREFIX=/api/v1
TZ=Asia/Ho_Chi_Minh
DEBUG=true
SQL_ECHO=false

# --- Database ---
DATABASE_URL=sqlite:///./data/sqlite/teambuilding.db

# --- Auth ---
# Sinh khoá: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (chỉ cần khi chạy FE ở cổng riêng lúc dev) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email (SMTP) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=BTC Team Building
SMTP_FROM_EMAIL=noreply@company.vn
APP_PUBLIC_URL=http://localhost:3000

# --- RAG / LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=4096
CHROMA_PERSIST_DIR=./data/chromadb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35
CHAT_RATE_LIMIT_PER_10MIN=20

# --- Upload ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=2

# --- Frontend (dùng lúc build) ---
VITE_API_BASE_URL=/api/v1
